NODE_ENV=production
NEXUS_HOST=nexus.example.com
ACME_EMAIL=admin@example.com
POSTGRES_PASSWORD=replace-with-owner-password
APP_DB_PASSWORD=replace-with-app-password
DATABASE_URL=postgres://nexus:replace-with-app-password@database:5432/nexus
REDIS_PASSWORD=replace-with-redis-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
CORS_ORIGIN=https://nexus.example.com
ADMIN_EMAIL=admin@m4m0.es
ADMIN_PASSWORD=replace-with-16-or-more-characters
PORT=3001
BACKUP_DIR=/data/backups
PLUGIN_DIR=/opt/nexus/plugins
WEBHOOK_ALLOWED_ORIGINS=https://hooks.slack.com
